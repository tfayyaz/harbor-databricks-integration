# Copy to .env.local (gitignored) and fill in only what your machine needs.
# Entry-point scripts load .env.local if it exists. Never commit real values.

# Package mirrors, if your network blocks the public registries
# NPM_CONFIG_REGISTRY=
# UV_INDEX_URL=
# PIP_INDEX_URL=

# Databricks CLI profiles (names only; credentials stay in ~/.databrickscfg)
# DATABRICKS_PROFILE=
# DATABRICKS_M2M_PROFILE=
